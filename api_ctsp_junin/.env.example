PORT=8000

# URL base de la aplicación
APP_URL=http://localhost:8000

# Origenes permitidos para CORS (Cross-Origin Resource Sharing)
# Usar '*' permite cualquier origen, lo cual es adecuado para desarrollo,
# pero en producción se recomienda especificar orígenes específicos.
CORS_ORIGIN=*

# Configuración de la base de datos
DB_HOST=
DB_PORT=
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=

JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# ===========================================
# CONFIGURACIÓN DE CORREO (SMTP)
# Compatible: Gmail, Outlook, Yahoo, SendGrid, Mailgun, SMTP genérico
# ===========================================
# Servidor SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false          # true para puerto 465 (SSL), false para 587 (STARTTLS)

# Credenciales
MAIL_USER=tu_email@gmail.com
MAIL_PASS=tu_app_password   # Contraseña de aplicación (no tu contraseña normal)

# Remitente
MAIL_FROM=
MAIL_FROM_NAME=

# Entorno (afecta preview de emails y TLS)
NODE_ENV=development